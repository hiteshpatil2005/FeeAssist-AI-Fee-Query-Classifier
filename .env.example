# ──────────────────────────────────────────
# FeeAssist AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit production .env to version control.
# ──────────────────────────────────────────

# ── PostgreSQL (Docker) ───────────────────
POSTGRES_DB=feeassist
POSTGRES_USER=feeassist
POSTGRES_PASSWORD=feeassist_secret_pass

# ── Database URL (used by backend & alembic) ───────
# Uses postgres service name within Docker network
DATABASE_URL=postgresql+psycopg://feeassist:feeassist_secret_pass@postgres:5432/feeassist

# ── Security / JWT ────────────────────────
JWT_SECRET_KEY=feeassist_super_secret_jwt_key_2026_very_secure_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Gemini API (future) ──────────────────
GEMINI_API_KEY=

# ── Frontend ──────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
