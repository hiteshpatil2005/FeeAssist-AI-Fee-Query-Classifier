# ──────────────────────────────────────────
# FeeAssist AI — .gitignore
# ──────────────────────────────────────────

# Environment files
.env
.env.local
.env.*.local

# ── Node / Frontend ──────────────────────
node_modules/
dist/
build/
.vite/
frontend/node_modules/
frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
*.local

# ── Python / Backend ─────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
pip-selfcheck.json
*.egg-info/
dist/
build/
.eggs/
*.egg

# Coverage
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# ── ML ───────────────────────────────────
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt
ml/models/*.bin
*.csv
*.tsv

# ── Docker ───────────────────────────────
# (docker-compose.yml is tracked, .env is not)

# ── OS ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────
.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
